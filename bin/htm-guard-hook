#!/usr/bin/env python3
# htm-guard-hook: Claude Code PreToolUse hook (matcher Bash). Independent of PATH order, so it also
# catches absolute paths. Blocks commands that touch the live desktop unless an htm session is active.
import json, os, re, subprocess, sys

if os.environ.get("HTM_GUARD_OFF"):
    sys.exit(0)
try:
    cmd = json.load(sys.stdin).get("tool_input", {}).get("command", "")
except Exception:
    sys.exit(0)

# a desktop-touching tool in command position (start, or after ; & | ( ` $( { sudo/env/assignments)
pre = r'(?:^|[;&|(`{]|\$\()\s*(?:(?:sudo|env|exec|command|nohup|setsid|time)\s+|\w+=\S*\s+)*(?:\S*/)?'
touch = re.compile(pre + r'(?:wtype|ydotool|dotool|dotoolc|omarchy-restart-shell|hyprctl\s+(?:-\S+\s+)*(?:dispatch|reload|keyword))(?:\s|$|;|&|\|)', re.M)
if not touch.search(cmd):
    sys.exit(0)

htm = os.path.join(os.path.dirname(os.path.realpath(__file__)), "htm")
try:
    state = subprocess.run([htm, "status"], capture_output=True, text=True, timeout=5).stdout
except Exception:
    state = ""
if '"phase":"active"' in state:
    sys.exit(0)

sys.stderr.write(
    "Blocked: this command touches Libor's live desktop and no Ask Me While Testing session is active.\n"
    'Run:  htm start "<your name>: <what you will do>"   (5 s countdown + TESTING banner)\n'
    "Then repeat the command, and finish with:  htm end\n"
    'If htm start prints "cancelled" or "postpone:<min>": touch nothing, do other work, retry later.\n'
    "The human can disable this with htm-install-agent guard-remove or HTM_GUARD_OFF=1.\n")
sys.exit(2)
