#!/bin/bash
# talk-to-me-guard: installed as wtype / omarchy-restart-shell / hyprctl in ~/.local/bin.
# Inside an agent run (AI_AGENT, CLAUDECODE, OPENCODE, GEMINI_CLI, CODEX_THREAD_ID, or any other agent via TALK_TO_ME_GUARD=1 or the agent-env file)
# it refuses desktop-touching calls unless a talk-to-me session is active, so agents cannot move windows or
# send keys without the TESTING banner. Elsewhere it is a pass-through. TALK_TO_ME_GUARD_OFF=1 bypasses it.
name=$(basename "$0")
self=$(readlink -f "$0")

real=""
IFS=: read -ra dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  c="$d/$name"
  [[ -x $c && $(readlink -f "$c") != "$self" && $(readlink -f "$c") != */bin/talk-to-me-guard ]] && { real=$c; break; }
done
[[ -n $real ]] || { echo "$name: real command not found" >&2; exit 127; }

touches=0
case $name in
  wtype|omarchy-restart-shell) touches=1 ;;
  hyprctl) [[ " $* " =~ \ (dispatch|reload|keyword)\  || " $* " == *"dispatch "* ]] && touches=1 ;;
esac

# extra_agent_env: true when an env variable named in ~/.config/background-worker-talk-to-me/agent-env (one name per line) is set
extra_agent_env() {
  local f="${XDG_CONFIG_HOME:-$HOME/.config}/background-worker-talk-to-me/agent-env" n
  [[ -f $f ]] || return 1
  while read -r n _; do n=${n%%#*}; [[ $n =~ ^[A-Za-z_][A-Za-z0-9_]*$ && -n ${!n:-} ]] && return 0; done < "$f"
  return 1
}

in_agent=0
[[ -n ${AI_AGENT:-} || -n ${CLAUDECODE:-} || -n ${OPENCODE:-} || -n ${GEMINI_CLI:-} || -n ${CODEX_THREAD_ID:-} || ${TALK_TO_ME_GUARD:-} == 1 ]] && in_agent=1
(( in_agent )) || { extra_agent_env && in_agent=1; }

# isolated targets (another compositor, a HEADLESS-n monitor, TALK_TO_ME_ISOLATED=1) need no session
if (( touches && in_agent )) && "$(dirname "$self")/talk-to-me-guard-hook" --shim "$name" "$@" 2>/dev/null; then touches=0; fi

# once the outer command passed the check, commands it spawns (omarchy-restart-shell calls hyprctl while the shell is down) pass too
if (( touches && in_agent )) && [[ -z ${TALK_TO_ME_GUARD_OFF:-} && -z ${TALK_TO_ME_GUARD_CHECKED:-} ]]; then
  # plugin not running (status fails): nothing to ask, so let the command through instead of deadlocking
  if state=$("$(dirname "$self")/talk-to-me" status 2>/dev/null) && [[ $state != *'"phase":"active"'* ]]; then
    cat >&2 <<MSG
$name blocked: this touches the user's live desktop and no Agent Handshake session is active.
Run:  talk-to-me start "<your name>: <exactly what you test or do, and for which project or reason>"   (10 s countdown + TESTING banner; the title is shown in full, 5+ words, max 240 characters)
Not testing (restarting the shell, reloading Hyprland)? Add --work: the screens then say WORKING instead of TESTING.
Then repeat this command, and finish with:  talk-to-me end
If talk-to-me start prints "cancelled" or "postpone:<min>": touch nothing, do other work, retry later.
Not wanted? The human can run talk-to-me-install-agent guard-remove, or set TALK_TO_ME_GUARD_OFF=1.
MSG
    exit 99
  fi
fi
export TALK_TO_ME_GUARD_CHECKED=1
exec "$real" "$@"
