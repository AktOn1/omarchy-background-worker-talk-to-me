#!/bin/bash
# htm-guard: installed as wtype / omarchy-restart-shell / hyprctl in ~/.local/bin.
# Inside an agent run (Claude Code: CLAUDECODE, Paperclip: PAPERCLIP_RUN_ID, or any agent via HTM_GUARD=1)
# it refuses desktop-touching calls unless an htm session is active, so agents cannot move windows or
# send keys without the TESTING banner. Elsewhere it is a pass-through. HTM_GUARD_OFF=1 bypasses it.
name=$(basename "$0")
self=$(readlink -f "$0")

real=""
IFS=: read -ra dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  c="$d/$name"
  [[ -x $c && $(readlink -f "$c") != "$self" && $(readlink -f "$c") != */bin/htm-guard ]] && { real=$c; break; }
done
[[ -n $real ]] || { echo "$name: real command not found" >&2; exit 127; }

touches=0
case $name in
  wtype|omarchy-restart-shell) touches=1 ;;
  hyprctl) [[ " $* " =~ \ (dispatch|reload|keyword)\  || " $* " == *"dispatch "* ]] && touches=1 ;;
esac

in_agent=0
[[ -n ${PAPERCLIP_RUN_ID:-} || -n ${CLAUDECODE:-} || ${HTM_GUARD:-} == 1 ]] && in_agent=1

if (( touches && in_agent )) && [[ -z ${HTM_GUARD_OFF:-} ]]; then
  state=$("$(dirname "$self")/htm" status 2>/dev/null)
  if [[ $state != *'"phase":"active"'* ]]; then
    cat >&2 <<MSG
$name blocked: this touches Libor's live desktop and no Background Worker Talk To Me session is active.
Run:  htm start "<your name>: <what you will do>"   (5 s countdown + TESTING banner)
Then repeat this command, and finish with:  htm end
If htm start prints "cancelled" or "postpone:<min>": touch nothing, do other work, retry later.
Not wanted? The human can run htm-install-agent guard-remove, or set HTM_GUARD_OFF=1.
MSG
    exit 99
  fi
fi
exec "$real" "$@"
