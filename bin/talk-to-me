#!/bin/bash
# talk-to-me: command line for the Background Worker Talk To Me Omarchy shell plugin.
# Usage: talk-to-me start TITLE [--help TEXT] [--estimate DUR] [--work] [--countdown SEC] [--max MIN] [--no-shield] [--no-hide]   -> human | solo | cancelled | postpone:<min>
#        talk-to-me ask "QUESTION" [--text] [--timeout SEC]       -> yes | no | unsure | text:<typed> | postpone:<min> | timeout | ended
#        talk-to-me question "QUESTION" [--text] [--timeout SEC]  (experimental, off by default)
#        talk-to-me say "TEXT"
#        talk-to-me eta DUR       (revise the expected remaining time: 90s, 3m or 3 = minutes)
#        talk-to-me notice "TEXT" [--seconds N]   (banner without a session; the agent watcher uses it)
#        talk-to-me end [--quiet]   (a green checkmark card says the work is done; --quiet or --failed skips it)
#        talk-to-me need cpu|vm|gpu TITLE [--estimate DUR] [--max MIN] [--wait SEC]   -> granted | timeout | cancelled   (hardware announcement; screen = talk-to-me start)
#        talk-to-me release [cpu|vm|gpu|all] [--id ID]
#        talk-to-me hardware [rules]
#        talk-to-me status
#        talk-to-me require [WHAT]    -> exit 0 ok, 99 = agent run with no active session (put it in launcher scripts)
set -u

usage() {
  cat <<'USAGE'
talk-to-me: Background Worker Talk To Me

  talk-to-me start [LABEL] [--help TEXT] [--estimate DUR] [--work] [--countdown SEC] [--max MIN] [--no-shield] [--no-hide]
      TITLE (required): one full sentence the person reads on the card and banner, never cut off (max 240 characters):
      who you are, exactly what is tested or done, and for which project or reason. Too short or generic titles
      ("Desktop testing", "demo") are refused with exit 2 and nothing starts.
      Countdown banner (default 10 s). It is a heads-up, not a question: the person who is at the
      desk postpones (Ctrl+P) or cancels (Ctrl+Q), otherwise it runs out and you continue alone ("solo";
      "talk-to-me ask" then prints "timeout" at once). No Ctrl+Y key unless you pass --help.
      --help "what I need": say what the person could do that is faster than you testing alone
      ("watch the screen and answer Ctrl+Y / Ctrl+N after each window move"). The card then shows it with
      a Ctrl+Y key. Prints "human" when they pressed Ctrl+Y (now "talk-to-me ask" works), "solo" when nobody did,
      "cancelled" when they pressed Ctrl+Q (not now: stop, touch nothing).
      --estimate DUR: how long you expect to need ("90s", "3m", or a bare number = minutes). The countdown card
      shows "Expected duration" and the banner counts "about 2:10 left", then "taking longer". Always give one:
      the person decides from it whether to postpone. Without it the banner only shows the time so far.
      Solo runs (nobody pressed Ctrl+Y) put an invisible MOUSE SHIELD over every screen so stray clicks cannot spoil
      the test; the banner stays clickable and ends the test. The keyboard is not blocked (your own wtype keys
      reach the focused window). When the person helps (Ctrl+Y), no shield. --no-shield: skip it, e.g. when you drive
      the mouse yourself (ydotool).
      --work: you are NOT testing, you do something else that touches the desktop (restart the shell, reload
      Hyprland, install or change a plugin). The screens then say "WORKING" instead of "TESTING". Everything else
      (countdown, shield, postpone, estimate, checkmark at the end) is the same; use "talk-to-me ask" only for tests.
      While you work, every screen shows an EMPTY workspace: the person's windows are not closed or moved, just
      out of sight, and come back when the session ends (end, Ctrl+Q, postpone, time limit, shell restart). Windows you
      open land on the empty workspace. --no-hide: keep their windows on screen, for a test that needs the
      existing windows (e.g. it moves or reads an app the person already has open).
      Ctrl+P = the person wants to test later: they type minutes, the banner turns into a "paused"
      pill and this prints postpone:<minutes> (exit 5). Wait that long, then run talk-to-me start again.
      Exit codes: 0 human/solo, 1 error, 4 cancelled, 5 postponed.
  talk-to-me ask "QUESTION" [--text] [--timeout SEC]
      Shows the question; Ctrl+Y / Ctrl+N / Ctrl+/ answers (Ctrl+T = the person types a reply instead).
      With --text a textbox opens at once (use it for open questions: "What do you see?").
      P = the person wants to postpone the test: they type minutes, the banner turns into a
      "paused" pill and this prints postpone:<minutes> (exit 5). The session is already over:
      stop touching the desktop, wait that long, then run talk-to-me start again.
      Prints yes | no | unsure | text:<typed answer> | postpone:<min> | timeout | ended.
      "timeout" is printed at once in solo mode. "ended" = the person pressed Ctrl+Q:
      stop testing. Exit codes: 0 answered, 1 error, 3 no session (run talk-to-me start), 4 ended, 5 postponed.
  talk-to-me question "QUESTION" [--text] [--timeout SEC]      (EXPERIMENTAL, off by default)
      A plain question card with no testing session and no banner, for a decision you are
      blocked on while the person works in another app. Ctrl+Y / Ctrl+N / Ctrl+/ / Ctrl+T (type) answer, Ctrl+Q dismisses.
      Prints yes | no | unsure | text:<typed> | dismissed | timeout | busy.
      Exit codes: 0 answered, 4 dismissed, 6 not allowed (setting is off, or asked too soon after
      the last question): decide yourself or use your normal question channel.
      Turn it on with: talk-to-me settings set questions on
  talk-to-me settings [get KEY | set KEY VALUE | reset [KEY]]
      Show or change the settings (stored in ~/.config/background-worker-talk-to-me/settings.conf).
        questions         on|off   allow "talk-to-me question" (default off, experimental)
        watch             on|off   agent watcher: banner when any agent opens a window with no session (default on)
        shield            on|off   invisible mouse shield over every screen during solo tests (default on)
        hide              on|off   switch every screen to an empty workspace while the agent works (default on)
        notice-seconds    SEC      how long that notice stays (default 12, 3-120)
        question-timeout  SEC      how long a question card stays (default 120, 3-600)
        question-gap      SEC      minimum seconds between two questions (default 60, 0-3600)
        countdown         SEC      default start countdown (default 10, 1-30)
        max               MIN      default session limit (default 20, 1-240)
        ask-timeout       SEC      default for talk-to-me ask (default 60, 3-600)
        text-timeout      SEC      default for talk-to-me ask --text (default 120, 3-600)
        hw-cpu|hw-vm|hw-gpu  on|off  announce that hardware kind with talk-to-me need (default on; off = need returns at once, no pill)
        hw-queue          on|off   agents wait their turn for a kind: hw-slots holders at a time (default off = banner only)
        hw-slots          N        how many agents may hold one kind at once when the queue is on (default 1, 1-4)
        hw-enforce        on|off   the guard blocks heavy commands (vm-test, ComfyUI jobs, ollama, ...) until the kind is announced (default off)
        hw-max            MIN      an announcement expires after this long if the agent forgets to release (default 60, 1-480)
        hw-wait           SEC      how long talk-to-me need waits in the queue (default 900, 10-3600)
        hw-gpu-vram       GB       "heavy GPU use" = more than this much VRAM, or hw-minutes of load (default 2)
        hw-vm-ram         GB       "a VM with lots of resources" = more than this much RAM (default 4)
        hw-cpu-ram        GB       "heavy CPU/RAM job" = more than this much RAM, or hw-minutes of full load on hw-cpu-threads (default 8)
        hw-cpu-threads    N        threads kept busy (default 8)
        hw-minutes        MIN      how long a job runs before it counts as heavy (default 2)
      Command-line options (--countdown, --max, --timeout) still win over settings.
  talk-to-me say "TEXT"      Short status line on the banner (no answer needed).
  talk-to-me eta DUR         Revise the expected remaining time while a test runs (same units as --estimate).
  talk-to-me notice "TEXT" [--seconds N]
      A short "agent activity" banner on every screen, no session needed (default 12 s, click to dismiss).
      The agent watcher (talk-to-me-watch) shows it when a window opens from an agent run with no session.
  talk-to-me end [--quiet]   Remove the banner and finish the session. Shows a green checkmark "DONE" card for 3 s on every screen
      (the person sees the work is finished and the desktop is theirs again). Use --quiet (or --failed) when the test failed or you
      ended it only to clean up, so no success is shown.
  talk-to-me status          Print the session state as JSON.
  talk-to-me need cpu|vm|gpu "TITLE" [--estimate DUR] [--max MIN] [--wait SEC]
      Announce that you need heavy hardware BEFORE you use it: cpu = a heavy CPU/RAM job, vm = a VM with a lot of resources,
      gpu = heavy GPU use. (A screen, keyboard or mouse is talk-to-me start; "need screen ..." is the same command.)
      TITLE is one full sentence (who you are, what runs, for which project or reason; same rules as start).
      A pill with your title and a timer shows on the person's screen until you run  talk-to-me release KIND  (or --max
      minutes pass, default 60). With the queue setting on, only hw-slots agents hold a kind at a time: you wait your turn
      (up to --wait seconds) and this prints "granted" when it is yours. Prints granted | timeout | cancelled (the person
      removed you from the queue). Exit codes: 0 granted, 4 cancelled, 7 timeout. Run  talk-to-me hardware rules  to see what counts as heavy.
  talk-to-me release [cpu|vm|gpu|all] [--id ID]    You are done with that hardware (the pill and your queue slot go away).
  talk-to-me hardware        JSON: who holds or waits for CPU/RAM, VM and GPU right now.
  talk-to-me hardware rules  What counts as "a lot of resources" on this machine (the thresholds from the settings).
  talk-to-me require [WHAT]  For launcher scripts that open a window (a game, an app): exits 0 when it is fine
      to go on, 99 (with a message) when an agent run (AI_AGENT, CLAUDECODE, OPENCODE, GEMINI_CLI, CODEX_THREAD_ID, or TALK_TO_ME_GUARD=1 or the agent-env file)
      has no active session. Always 0 for a person at a terminal or with TALK_TO_ME_GUARD_OFF=1.

Environment: TALK_TO_ME_QS_PATH=<dir> talks to a scratch Quickshell config instead of omarchy-shell.
USAGE
}

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/talk-to-me"
ID=""

ipc() {
  if [[ -n ${TALK_TO_ME_QS_PATH:-} ]]; then
    timeout --kill-after=1s 3s qs ipc -n -p "$TALK_TO_ME_QS_PATH" call -- talk-to-me "$@" 2>/dev/null
  else
    export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
    omarchy-shell talk-to-me "$@" 2>&1
  fi
}

die() { echo "talk-to-me: $1" >&2; exit 1; }

# The title is the only thing the person sees about the run: it must say what and why, in full.
check_title() {
  [[ ${TALK_TO_ME_ALLOW_SHORT_TITLE:-} == 1 ]] && return 0
  local t=$1 words
  t=${t//[[:space:]]/ }
  words=$(wc -w <<<"$t")
  if (( ${#t} > 240 )); then
    echo "talk-to-me: the title is ${#t} characters; the limit is 240 (it is shown in full, never cut off). Shorten it." >&2
    exit 2
  fi
  if (( words < 5 || ${#t} < 30 )); then
    cat >&2 <<'MSG'
talk-to-me: the title does not say what is being done. Nothing was started.
The person reads ONLY this title. Write one complete sentence: who you are, exactly what you test or do, and for which project or reason.
  talk-to-me start "Claude Code: checking the new window-move animation of the Fullscreen Auto Workspace plugin on workspace 3" --estimate 3m
  talk-to-me start "Claude Code: restarting the Omarchy shell to load the updated Ask Me While Testing plugin" --work --estimate 1m
Not: "Desktop testing", "demo", "plugin check". Max 240 characters, shown in full.
MSG
    exit 2
  fi
}

# Calls the plugin; fails with a clear message when the shell or plugin is not there.
# extra_agent_env: true when an env variable named in ~/.config/background-worker-talk-to-me/agent-env (one name per line) is set
extra_agent_env() {
  local f="${XDG_CONFIG_HOME:-$HOME/.config}/background-worker-talk-to-me/agent-env" n
  [[ -f $f ]] || return 1
  while read -r n _; do n=${n%%#*}; [[ $n =~ ^[A-Za-z_][A-Za-z0-9_]*$ && -n ${!n:-} ]] && return 0; done < "$f"
  return 1
}

call() {
  local out
  out=$(ipc "$@") || die "${out:-omarchy-shell is not running}"
  case $out in
    ok|"{"*) printf '%s\n' "$out" ;;
    *"Target not found"*) die "plugin not loaded (omarchy plugin enable io.github.akton1.background-worker-talk-to-me)" ;;
    error:*) die "${out#error:}" ;;
    *) die "${out:-no answer from the shell}" ;;
  esac
}

CONF_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/background-worker-talk-to-me/settings.conf"
SETTING_KEYS="questions watch shield hide notice-seconds question-timeout question-gap countdown max ask-timeout text-timeout hw-cpu hw-vm hw-gpu hw-queue hw-slots hw-enforce hw-max hw-wait hw-gpu-vram hw-vm-ram hw-cpu-ram hw-cpu-threads hw-minutes"

setting_is_bool() { case $1 in questions|watch|shield|hide|hw-cpu|hw-vm|hw-gpu|hw-queue|hw-enforce) return 0 ;; *) return 1 ;; esac; }

setting_default() {
  case $1 in
    questions) echo off ;;
    watch) echo on ;;
    shield) echo on ;;
    hide) echo on ;;
    notice-seconds) echo 12 ;;
    question-timeout) echo 120 ;;
    question-gap) echo 60 ;;
    countdown) echo 10 ;;
    max) echo 20 ;;
    ask-timeout) echo 60 ;;
    text-timeout) echo 120 ;;
    hw-cpu|hw-vm|hw-gpu) echo on ;;
    hw-queue|hw-enforce) echo off ;;
    hw-slots) echo 1 ;;
    hw-max) echo 60 ;;
    hw-wait) echo 900 ;;
    hw-gpu-vram) echo 2 ;;
    hw-vm-ram) echo 4 ;;
    hw-cpu-ram) echo 8 ;;
    hw-cpu-threads) echo 8 ;;
    hw-minutes) echo 2 ;;
    *) return 1 ;;
  esac
}

setting_range() {
  case $1 in
    question-timeout|ask-timeout|text-timeout) echo "3 600" ;;
    notice-seconds) echo "3 120" ;;
    question-gap) echo "0 3600" ;;
    countdown) echo "1 30" ;;
    max) echo "1 240" ;;
    hw-slots) echo "1 4" ;;
    hw-max) echo "1 480" ;;
    hw-wait) echo "10 3600" ;;
    hw-gpu-vram|hw-vm-ram|hw-cpu-ram) echo "1 128" ;;
    hw-cpu-threads) echo "1 256" ;;
    hw-minutes) echo "1 60" ;;
  esac
}

# Prints the stored value, or the default.
setting_get() {
  local key=$1 line value=""
  if [[ -r $CONF_FILE ]]; then
    line=$(grep -m1 "^$key=" "$CONF_FILE" 2>/dev/null || true)
    value=${line#*=}
  fi
  if [[ -z $value ]]; then setting_default "$key"; return; fi
  if setting_is_bool "$key"; then
    case $value in on|off) echo "$value" ;; *) setting_default "$key" ;; esac
  elif [[ $value =~ ^[0-9]+$ ]]; then echo "$value"
  else setting_default "$key"; fi
}

setting_valid_key() { [[ " $SETTING_KEYS " == *" $1 "* ]]; }

setting_validate() {
  local key=$1 value=$2 lo hi
  if setting_is_bool "$key"; then
    [[ $value == on || $value == off ]] || die "$key takes on or off"
    return
  fi
  [[ $value =~ ^[0-9]+$ ]] || die "$key takes a whole number"
  read -r lo hi <<<"$(setting_range "$key")"
  (( value >= lo && value <= hi )) || die "$key must be between $lo and $hi"
}

setting_set() {
  local key=$1 value=$2 tmp
  setting_valid_key "$key" || die "unknown setting '$key' (talk-to-me settings lists them)"
  setting_validate "$key" "$value"
  mkdir -p "${CONF_FILE%/*}"
  tmp=$(mktemp "$CONF_FILE.XXXXXX")
  { [[ -r $CONF_FILE ]] && grep -v "^$key=" "$CONF_FILE"; echo "$key=$value"; } > "$tmp" 2>/dev/null || echo "$key=$value" > "$tmp"
  mv "$tmp" "$CONF_FILE"
}

setting_reset() {
  local key=$1 tmp
  [[ -r $CONF_FILE ]] || return 0
  if [[ -z $key ]]; then rm -f "$CONF_FILE"; return 0; fi
  setting_valid_key "$key" || die "unknown setting '$key' (talk-to-me settings lists them)"
  tmp=$(mktemp "$CONF_FILE.XXXXXX")
  grep -v "^$key=" "$CONF_FILE" > "$tmp" || true
  mv "$tmp" "$CONF_FILE"
}

# "90s" -> 90, "3m" or "3" -> 180 seconds; dies on anything else.
to_seconds() {
  local v=$1
  case $v in
    *s) v=${v%s}; [[ $v =~ ^[0-9]+$ ]] || die "bad duration '$1' (use 90s, 3m or minutes)"; echo "$v" ;;
    *m) v=${v%m}; [[ $v =~ ^[0-9]+$ ]] || die "bad duration '$1' (use 90s, 3m or minutes)"; echo $((v * 60)) ;;
    *) [[ $v =~ ^[0-9]+$ ]] || die "bad duration '$1' (use 90s, 3m or minutes)"; echo $((v * 60)) ;;
  esac
}

# a password prompt (polkit dialog, screen lock) must never lose the keyboard to our start card: wait for it, at most 2 minutes
password_prompt_up() { pgrep -x hyprlock >/dev/null 2>&1 || command hyprctl layers 2>/dev/null | grep -q 'namespace: omarchy-polkit'; }
wait_password_prompt() { local n=0; while password_prompt_up && (( n < 120 )); do sleep 1; n=$((n + 1)); done; }

HW="$(dirname "$(readlink -f "$0")")/talk-to-me-hw"

# who is asking: lets "release gpu" free only your own announcement (a shared "-" when the agent has no run id)
hw_owner() { echo "${TALK_TO_ME_OWNER:-${CODEX_THREAD_ID:-${CLAUDE_CODE_SESSION_ID:--}}}"; }

new_id() { head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

cleanup() {
  [[ -n $ID ]] && rm -f "$RUNTIME_DIR/$ID.result" "$RUNTIME_DIR/$ID.result.tmp"
}

# Waits for the plugin to write the result file; prints its first line.
wait_result() {
  local file="$RUNTIME_DIR/$ID.result" limit=$1 start=$SECONDS
  while (( SECONDS - start < limit )); do
    if [[ -s $file ]]; then
      head -n1 "$file"
      return 0
    fi
    sleep 0.1
  done
  return 1
}

on_signal() {
  [[ -n $ID ]] && ipc cancel "$ID" >/dev/null 2>&1
  cleanup
  exit 130
}

[[ $# -ge 1 ]] || { usage; exit 1; }
cmd=$1; shift

case $cmd in
  -h|--help|help) usage ;;

  start)
    label="" help="" kind=test estimate=0 shield=$(setting_get shield) hide=$(setting_get hide) countdown=$(setting_get countdown) max=$(setting_get max)
    while (( $# )); do
      case $1 in
        --help) help=${2:?--help needs text}; shift 2 ;;
        --estimate) estimate=$(to_seconds "${2:?--estimate needs a duration}") || exit 1; shift 2 ;;
        --countdown) countdown=${2:?--countdown needs seconds}; shift 2 ;;
        --max) max=${2:?--max needs minutes}; shift 2 ;;
        --no-shield) shield=off; shift ;;
        --no-hide) hide=off; shift ;;
        --work) kind=work; shift ;;
        *) label=$1; shift ;;
      esac
    done
    [[ $countdown =~ ^[0-9]+$ && $max =~ ^[0-9]+$ ]] || die "--countdown and --max take whole numbers"
    check_title "$label"
    mkdir -p -m 700 "$RUNTIME_DIR"
    ID=$(new_id)
    trap on_signal INT TERM
    trap cleanup EXIT
    wait_password_prompt
    call start "$ID" "$label" "$countdown" "$max" "$help" "$estimate" "$([[ $shield == off ]] && echo 0 || echo 1)" "$kind" "$([[ $hide == off ]] && echo 0 || echo 1)" >/dev/null
    # typing a postpone time (P) pauses the countdown for up to 60 s
    result=$(wait_result $((countdown + 70 + 125))) || { ipc cancel "$ID" >/dev/null 2>&1; die "no answer from the plugin"; }
    echo "$result"
    [[ $result == cancelled ]] && exit 4
    [[ $result == postpone:* ]] && exit 5
    exit 0
    ;;

  ask)
    question="" timeout="" kind=choice
    while (( $# )); do
      case $1 in
        --timeout) timeout=${2:?--timeout needs seconds}; shift 2 ;;
        --text) kind=text; shift ;;
        *) question=$1; shift ;;
      esac
    done
    [[ -n $question ]] || die 'usage: talk-to-me ask "QUESTION" [--text] [--timeout SEC]'
    if [[ -z $timeout ]]; then
      if [[ $kind == text ]]; then timeout=$(setting_get text-timeout); else timeout=$(setting_get ask-timeout); fi
    fi
    [[ $timeout =~ ^[0-9]+$ ]] || die "--timeout takes whole seconds"
    mkdir -p -m 700 "$RUNTIME_DIR"
    ID=$(new_id)
    trap on_signal INT TERM
    trap cleanup EXIT
    call ask "$ID" "$question" "$timeout" "$kind" >/dev/null
    # typing a reply (Ctrl+T) can extend a choice question by up to 90 s
    grace=8; [[ $kind == choice ]] && grace=98
    grace=$((grace + 125))  # Ctrl-alone hold: up to 120 s
    result=$(wait_result $((timeout + grace))) || { ipc cancel "$ID" >/dev/null 2>&1; result=timeout; }
    case $result in
      nosession) die "no session: run 'talk-to-me start' first" ;;
      ended) echo ended; exit 4 ;;
      superseded) echo timeout ;;
      postpone:*) echo "$result"; exit 5 ;;
      *) echo "$result" ;;
    esac
    ;;

  question)
    question="" timeout="" kind=choice
    while (( $# )); do
      case $1 in
        --timeout) timeout=${2:?--timeout needs seconds}; shift 2 ;;
        --text) kind=text; shift ;;
        *) question=$1; shift ;;
      esac
    done
    [[ -n $question ]] || die 'usage: talk-to-me question "QUESTION" [--text] [--timeout SEC]'
    if [[ $(setting_get questions) != on ]]; then
      echo "disabled"
      echo "talk-to-me: standalone questions are off (experimental). The person can turn them on with: talk-to-me settings set questions on" >&2
      exit 6
    fi
    [[ -n $timeout ]] || timeout=$(setting_get question-timeout)
    [[ $timeout =~ ^[0-9]+$ ]] || die "--timeout takes whole seconds"
    mkdir -p -m 700 "$RUNTIME_DIR"
    stamp="$RUNTIME_DIR/last-question"
    gap=$(setting_get question-gap)
    if [[ -r $stamp ]]; then
      last=$(cat "$stamp" 2>/dev/null); last=${last:-0}
      now=$(date +%s)
      if [[ $last =~ ^[0-9]+$ ]] && (( now - last < gap )); then
        echo "toosoon"
        echo "talk-to-me: last question was $((now - last)) s ago (question-gap is $gap s). Decide yourself or batch your questions." >&2
        exit 6
      fi
    fi
    ID=$(new_id)
    trap on_signal INT TERM
    trap cleanup EXIT
    call quick "$ID" "$question" "$timeout" "$kind" >/dev/null
    date +%s > "$stamp"
    grace=8
    [[ $kind == choice ]] && grace=98
    grace=$((grace + 125))
    result=$(wait_result $((timeout + grace))) || { ipc cancel "$ID" >/dev/null 2>&1; result=timeout; }
    case $result in
      dismissed) echo dismissed; exit 4 ;;
      superseded|ended|postpone:*) echo timeout ;;
      busy) echo busy; echo "talk-to-me: another card is on screen right now" >&2; exit 6 ;;
      *) echo "$result" ;;
    esac
    ;;

  settings)
    sub=${1:-list}
    case $sub in
      list|"")
        for key in $SETTING_KEYS; do
          value=$(setting_get "$key")
          mark=""; [[ $value == "$(setting_default "$key")" ]] || mark="  (default $(setting_default "$key"))"
          printf '%-17s %s%s\n' "$key" "$value" "$mark"
        done
        ;;
      get)
        [[ $# -ge 2 ]] || die "usage: talk-to-me settings get KEY"
        setting_valid_key "$2" || die "unknown setting '$2'"
        setting_get "$2"
        ;;
      set)
        [[ $# -ge 3 ]] || die "usage: talk-to-me settings set KEY VALUE"
        setting_set "$2" "$3"
        echo "$2=$(setting_get "$2")"
        ;;
      reset)
        setting_reset "${2:-}"
        echo "reset"
        ;;
      *) die "usage: talk-to-me settings [get KEY | set KEY VALUE | reset [KEY]]" ;;
    esac
    ;;

  notice)
    secs=$(setting_get notice-seconds) text=""
    while (( $# )); do
      case $1 in
        --seconds) secs=${2:?--seconds needs a number}; shift 2 ;;
        *) text=${text:+$text }$1; shift ;;
      esac
    done
    [[ -n $text ]] || die 'usage: talk-to-me notice "TEXT" [--seconds N]'
    call notice "$text" "$secs" >/dev/null
    ;;

  eta)
    [[ $# -ge 1 ]] || die 'usage: talk-to-me eta DUR  (90s, 3m or minutes)'
    call eta "$(to_seconds "$1")" >/dev/null
    ;;

  say)
    [[ $# -ge 1 ]] || die 'usage: talk-to-me say "TEXT"'
    call say "$*" >/dev/null
    ;;

  end)
    if [[ ${1:-} == --quiet || ${1:-} == --failed ]]; then call endquiet >/dev/null; else call end >/dev/null; fi
    ;;

  need)
    kind=${1:-}; shift || true
    case $kind in
      screen) exec "$0" start "$@" ;;
      cpu|vm|gpu) ;;
      *) die 'usage: talk-to-me need cpu|vm|gpu "TITLE" [--estimate DUR] [--max MIN] [--wait SEC]   (a screen is: talk-to-me start)' ;;
    esac
    label="" estimate=0 max=$(setting_get hw-max) wait=$(setting_get hw-wait)
    while (( $# )); do
      case $1 in
        --estimate) estimate=$(to_seconds "${2:?--estimate needs a duration}") || exit 1; shift 2 ;;
        --max) max=${2:?--max needs minutes}; shift 2 ;;
        --wait) wait=${2:?--wait needs seconds}; shift 2 ;;
        *) label=$1; shift ;;
      esac
    done
    [[ $max =~ ^[0-9]+$ && $wait =~ ^[0-9]+$ ]] || die "--max and --wait take whole numbers"
    check_title "$label"
    if [[ $(setting_get "hw-$kind") == off ]]; then
      echo granted
      echo "talk-to-me: '$kind' is not announced on this machine (setting hw-$kind is off); go ahead." >&2
      exit 0
    fi
    slots=$(setting_get hw-slots)
    queue=0; [[ $(setting_get hw-queue) == on ]] && queue=1
    line=$("$HW" need --kind "$kind" --title "$label" --estimate "$estimate" --max "$max" --slots "$slots" --queue "$queue" --owner "$(hw_owner)" --pid $$) \
      || die "could not record the announcement"
    IFS=$'\t' read -r hwid state pos holders <<<"$line"
    if [[ $state == active ]]; then
      [[ -n $holders ]] && echo "talk-to-me: $kind is also in use by: $holders" >&2
      echo granted
      exit 0
    fi
    trap '"$HW" release --id "$hwid" >/dev/null 2>&1; exit 130' INT TERM
    echo "talk-to-me: $kind is busy ($holders). You are number $pos in the queue; waiting up to $wait s. Do other work meanwhile." >&2
    waited=0
    while :; do
      sleep 1; waited=$((waited + 1))
      IFS=$'\t' read -r state pos <<<"$("$HW" poll "$hwid" --slots "$slots")"
      case $state in
        active) echo granted; exit 0 ;;
        gone) echo cancelled; exit 4 ;;
      esac
      if (( waited >= wait )); then
        "$HW" release --id "$hwid" >/dev/null 2>&1
        echo timeout
        echo "talk-to-me: still $kind busy after $wait s. Do other work and try again later, or run without it if the job is light." >&2
        exit 7
      fi
    done
    ;;

  release)
    what="" rid=""
    while (( $# )); do
      case $1 in
        --id) rid=${2:?--id needs an id}; shift 2 ;;
        *) what=$1; shift ;;
      esac
    done
    if [[ -n $rid ]]; then "$HW" release --id "$rid" >/dev/null
    else
      case ${what:-all} in
        cpu|vm|gpu) "$HW" release --kind "$what" --owner "$(hw_owner)" >/dev/null ;;
        all) "$HW" release --all --owner "$(hw_owner)" >/dev/null ;;
        screen) "$0" end ;;
        *) die "usage: talk-to-me release [cpu|vm|gpu|all] [--id ID]" ;;
      esac
    fi
    echo released
    ;;

  hardware|hw)
    case ${1:-} in
      rules)
        cat <<RULES
Announce with  talk-to-me need KIND "<full title>" --estimate DUR  before you start, and  talk-to-me release KIND  when done.
  screen  your use of the person's screen, keyboard or mouse                 -> talk-to-me start (see above)
  cpu     a job that needs more than $(setting_get hw-cpu-ram) GB RAM, or keeps $(setting_get hw-cpu-threads)+ threads busy for $(setting_get hw-minutes)+ min (big builds, encodes, test suites)
  vm      a VM or container with more than $(setting_get hw-vm-ram) GB RAM, or any VM test run (vm-test, qemu)
  gpu     more than $(setting_get hw-gpu-vram) GB VRAM, or load for $(setting_get hw-minutes)+ min (ComfyUI jobs, image/voice/LLM models, video encodes on the GPU)
Queue: $(setting_get hw-queue) (hw-slots $(setting_get hw-slots) at a time).  Guard enforcement: $(setting_get hw-enforce).
Announced kinds: cpu $(setting_get hw-cpu), vm $(setting_get hw-vm), gpu $(setting_get hw-gpu)  (off = need returns at once).
RULES
        ;;
      ""|list) "$HW" list ;;
      *) die "usage: talk-to-me hardware [rules]" ;;
    esac
    ;;

  status)
    call status
    ;;

  require)
    [[ -n ${AI_AGENT:-} || -n ${CLAUDECODE:-} || -n ${OPENCODE:-} || -n ${GEMINI_CLI:-} || -n ${CODEX_THREAD_ID:-} || ${TALK_TO_ME_GUARD:-} == 1 ]] || extra_agent_env || exit 0
    [[ -z ${TALK_TO_ME_GUARD_OFF:-} ]] || exit 0
    state=$("$0" status 2>/dev/null) || exit 0
    [[ $state == *'"phase":"active"'* ]] && exit 0
    cat >&2 <<MSG
Blocked: ${1:-this} opens a window on the user's live desktop and no Background Worker Talk To Me session is active.
FIRST: can this run in a VM or a nested compositor instead? If it does not need the user's real logins, GPU or monitors, test there and no session is needed.
Run:  talk-to-me start "<your name>: <what you will do>" [--work if you are not testing] --help "watch the screen and answer Ctrl+Y / Ctrl+N after each change"
(10 s countdown + TESTING banner, so the user keeps mouse and keyboard to themselves). Then repeat this command,
and finish with:  talk-to-me end
If talk-to-me start prints "cancelled" or "postpone:<min>": touch nothing, do other work, retry later.
Headless runs (no window) need no session. The human can set TALK_TO_ME_GUARD_OFF=1.
MSG
    exit 99
    ;;

  *) usage; exit 1 ;;
esac
