#!/bin/bash
# htm-install-agent: opt-in setup of the agent side of Ask Me While Testing. Nothing here runs by itself.
set -euo pipefail
root=$(dirname "$(dirname "$(readlink -f "$0")")")
bindir=${HTM_BIN_DIR:-$HOME/.local/bin}
guarded=(wtype omarchy-restart-shell hyprctl)
start='<!-- ask-me-while-testing:start -->'
end='<!-- ask-me-while-testing:end -->'

usage() {
  cat <<U
Usage: htm-install-agent <command> [args]
  skill [DIR]        copy the Claude Code skill to DIR/ask-me-while-testing (default ~/.claude/skills)
  block FILE         add or update the agent instructions block in FILE (e.g. ~/.claude/CLAUDE.md or an AGENTS.md)
  guard              make wtype, omarchy-restart-shell and hyprctl refuse to touch the desktop in an agent run
                     until 'htm start' is active (links htm-guard into $bindir, which must come first in PATH)
  guard-remove       undo 'guard'
  all FILE           skill + block FILE + guard
  status             show what is installed
Agent runs are detected by CLAUDECODE or PAPERCLIP_RUN_ID; for other agents export HTM_GUARD=1.
U
}

install_skill() {
  local dir=${1:-$HOME/.claude/skills}
  mkdir -p "$dir/ask-me-while-testing"
  cp "$root/docs/skill/ask-me-while-testing/SKILL.md" "$dir/ask-me-while-testing/SKILL.md"
  echo "skill installed: $dir/ask-me-while-testing"
}

install_block() {
  local f=${1:?block needs a target file}
  local tmp; tmp=$(mktemp)
  { echo "$start"; awk '/^```markdown/{on=1;next} /^```$/{if(on)exit} on' "$root/docs/agent-instructions.md"; echo "$end"; } > "$tmp"
  [[ -s $tmp && $(wc -l < "$tmp") -gt 3 ]] || { echo "could not read block from docs/agent-instructions.md" >&2; rm -f "$tmp"; exit 1; }
  mkdir -p "$(dirname "$f")"; touch "$f"
  if grep -qF "$start" "$f"; then
    awk -v s="$start" -v e="$end" -v new="$tmp" '
      $0==s {while ((getline l < new) > 0) print l; skip=1; next}
      $0==e {skip=0; next}
      !skip' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    echo "block updated in $f"
  else
    { echo; cat "$tmp"; } >> "$f"
    echo "block added to $f"
  fi
  rm -f "$tmp"
}

install_guard() {
  mkdir -p "$bindir"
  ln -sf "$root/bin/htm" "$bindir/htm"
  for n in "${guarded[@]}"; do ln -sf "$root/bin/htm-guard" "$bindir/$n"; done
  echo "linked htm and guard (${guarded[*]}) into $bindir"
  case ":$PATH:" in *":$bindir:"*) ;; *) echo "warning: $bindir is not in PATH" >&2 ;; esac
}

remove_guard() {
  for n in "${guarded[@]}"; do
    [[ $(readlink -f "$bindir/$n" 2>/dev/null) == "$root/bin/htm-guard" ]] && rm "$bindir/$n" && echo "removed $bindir/$n"
  done
  return 0
}

status() {
  command -v htm >/dev/null && echo "htm: $(command -v htm)" || echo "htm: not in PATH"
  [[ -f $HOME/.claude/skills/ask-me-while-testing/SKILL.md ]] && echo "skill: installed" || echo "skill: not installed"
  for n in "${guarded[@]}"; do
    [[ $(readlink -f "$bindir/$n" 2>/dev/null) == "$root/bin/htm-guard" ]] && echo "guard $n: on" || echo "guard $n: off"
  done
}

case ${1:-} in
  skill) install_skill "${2:-}" ;;
  block) install_block "${2:-}" ;;
  guard) install_guard ;;
  guard-remove) remove_guard ;;
  all) install_skill; install_block "${2:?all needs a target file}"; install_guard ;;
  status) status ;;
  *) usage; exit 2 ;;
esac
